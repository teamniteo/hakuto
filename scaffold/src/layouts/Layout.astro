---
import "../index.css";
import { Button } from "@/components/ui/button";
import { Schema } from "astro-seo-schema";
import type { Thing, WithContext } from "schema-dts";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	socialImageUrl?: string;
	schema?: WithContext<Thing> | WithContext<Thing>[];
}

// Site-wide defaults — update these for each new site
const SITE_NAME = "Hakuto";
const SITE_DESCRIPTION = "Astro + shadcn/ui website template for Hakuto.";

// Agent readiness — set to true to expose site tools to AI agents via WebMCP
const ENABLE_WEBMCP = false;

const { url } = Astro;
const {
	title: pageTitle,
	description = SITE_DESCRIPTION,
	noindex = false,
	socialImageUrl,
	schema,
} = Astro.props;

// Construct uniform title: "Page Title | Site Name" or just "Site Name"
const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : SITE_NAME;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={url.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:type" content="website" />
    {socialImageUrl && (
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={title} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <Schema item={s} />)
      : <Schema item={schema} />
    )}
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col">
    {/* Template header with Hakuto branding */}
    <header class="border-b">
      <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-lg font-semibold tracking-tight">Hakuto Template</a>
        {/* Example React island (shadcn/ui). Remove if not needed. */}
        <Button variant="secondary" size="sm">Example Button</Button>
      </div>
    </header>

    <main class="flex-1 mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    {ENABLE_WEBMCP && (
      <script is:inline>
        // WebMCP: expose site tools to AI agents
        (function() {
          if (!navigator.modelContext) return;
          navigator.modelContext.registerTool({
            name: "search-site",
            description: "Search this site for a given query. Returns matching page titles and URLs.",
            inputSchema: {
              type: "object",
              properties: {
                query: { type: "string", description: "Search query" }
              },
              required: ["query"]
            },
            async execute({ query }) {
              try {
                const pagefind = await import("/pagefind/pagefind.js");
                await pagefind.init();
                const search = await pagefind.search(query);
                const results = await Promise.all(search.results.slice(0, 5).map(r => r.data()));
                return results.map(r => ({ title: r.meta?.title, url: r.url, excerpt: r.excerpt }));
              } catch (e) {
                return { results: [], message: "Search unavailable" };
              }
            }
          });
          navigator.modelContext.registerTool({
            name: "get-page-content",
            description: "Get the main text content of the current page as plain text.",
            inputSchema: { type: "object", properties: {}, required: [] },
            async execute() {
              const main = document.querySelector("main");
              return {
                title: document.title,
                url: window.location.href,
                content: main ? main.innerText.slice(0, 4000) : document.body.innerText.slice(0, 4000)
              };
            }
          });
          navigator.modelContext.registerTool({
            name: "navigate",
            description: "Navigate to a page on this site by path.",
            inputSchema: {
              type: "object",
              properties: {
                path: { type: "string", description: "Site path to navigate to" }
              },
              required: ["path"]
            },
            async execute({ path }) {
              window.location.href = path;
              return { navigated: path };
            }
          });
        })();
      </script>
    )}
  </body>
</html>
