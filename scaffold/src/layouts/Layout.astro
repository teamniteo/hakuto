---
import "../index.css";
import { Button } from "@/components/ui/button";
import Schema from "@/components/Schema.astro";
import type { Thing, WithContext } from "schema-dts";
import { SITE_DESCRIPTION, SITE_NAME } from "@/lib/site";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	socialImageUrl?: string;
	/** RSS/Atom feed URL, e.g. "/blog/rss.xml". Emits an autodiscovery <link>. */
	feedUrl?: string;
	schema?: WithContext<Thing> | WithContext<Thing>[];
}



// Agent readiness — WebMCP tools for in-page AI agents. On by default: the
// search tool runs on the Pagefind index every build already produces.
// Set to false to stop exposing tools to agents.
const ENABLE_WEBMCP = true;

const { url } = Astro;
const {
	title: pageTitle,
	description = SITE_DESCRIPTION,
	noindex = false,
	socialImageUrl,
	feedUrl,
	schema,
} = Astro.props;

// Construct uniform title: "Page Title | Site Name" or just "Site Name"
const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : SITE_NAME;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={url.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:type" content="website" />
    {socialImageUrl && (
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={title} />
    )}
    {feedUrl && (
      <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={feedUrl} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <Schema item={s} />)
      : <Schema item={schema} />
    )}
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col">
    {/* Template header with Hakuto branding */}
    <header class="border-b">
      <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-lg font-semibold tracking-tight">Hakuto Template</a>
        {/* Example React island (shadcn/ui). Remove if not needed. */}
        <Button variant="secondary" size="sm">Example Button</Button>
      </div>
    </header>

    <main class="flex-1 mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    {ENABLE_WEBMCP && (
      <script is:inline>
        // WebMCP (https://webmcp.org): expose site tools to in-page AI agents.
        // `search-site` is backed by the same Pagefind index the site's own search
        // UI uses — `pagefind()` is in astro.config.mjs, so `astro build` always
        // writes /pagefind/, whether or not a search page exists.
        (function () {
          // The spec moved from navigator.modelContext to document.modelContext;
          // shipping implementations are split, so accept either.
          var ctx =
            (typeof document !== "undefined" && document.modelContext) ||
            (typeof navigator !== "undefined" && navigator.modelContext);
          if (!ctx || typeof ctx.registerTool !== "function") return;

          // Tool results are MCP CallToolResult objects: { content: [{ type, text }] }.
          function reply(value) {
            return {
              content: [
                {
                  type: "text",
                  text: typeof value === "string" ? value : JSON.stringify(value, null, 2),
                },
              ],
            };
          }

          var pagefindPromise = null;
          function loadPagefind() {
            if (!pagefindPromise) {
              pagefindPromise = import("/pagefind/pagefind.js").then(async (pf) => {
                await pf.init();
                return pf;
              });
              // Do not cache a failure — a retry after a slow deploy should work.
              pagefindPromise.catch(() => {
                pagefindPromise = null;
              });
            }
            return pagefindPromise;
          }

          ctx.registerTool({
            name: "search-site",
            description:
              "Full-text search across every page of this site. Returns the best matching pages with their title, URL and a highlighted excerpt. Use this before guessing a URL.",
            inputSchema: {
              type: "object",
              properties: {
                query: { type: "string", description: "Search terms, e.g. 'pricing' or 'refund policy'" },
                limit: {
                  type: "number",
                  description: "Maximum number of results to return (1-20, default 5)",
                },
              },
              required: ["query"],
            },
            async execute({ query, limit }) {
              var max = Math.min(Math.max(Number(limit) || 5, 1), 20);
              var pf;
              try {
                pf = await loadPagefind();
              } catch (e) {
                // The index is only emitted by `astro build`, so this is the normal
                // answer on `astro dev`, not a site defect.
                return reply(
                  "Search index unavailable on this origin (it is generated at build time). Fall back to /sitemap-index.xml or /llms.txt.",
                );
              }
              var search = await pf.search(String(query));
              var results = await Promise.all(search.results.slice(0, max).map((r) => r.data()));
              if (results.length === 0) {
                return reply({ query: query, total: 0, results: [], message: "No pages matched." });
              }
              return reply({
                query: query,
                total: search.results.length,
                results: results.map((r) => ({
                  title: (r.meta && r.meta.title) || r.url,
                  url: new URL(r.url, window.location.origin).href,
                  // Pagefind wraps matches in <mark>; agents want plain text.
                  excerpt: String(r.excerpt || "").replace(/<[^>]+>/g, ""),
                })),
              });
            },
          });

          ctx.registerTool({
            name: "get-page-content",
            description: "Get the main text content of the page currently open, as plain text.",
            inputSchema: { type: "object", properties: {}, required: [] },
            async execute() {
              var main = document.querySelector("main");
              return reply({
                title: document.title,
                url: window.location.href,
                content: (main || document.body).innerText.slice(0, 4000),
              });
            },
          });

          ctx.registerTool({
            name: "navigate",
            description: "Navigate to a page on this site by path, e.g. '/pricing/'.",
            inputSchema: {
              type: "object",
              properties: { path: { type: "string", description: "Site path to navigate to" } },
              required: ["path"],
            },
            async execute({ path }) {
              // Same-origin only — this tool must not be a redirect gadget.
              var target = new URL(String(path), window.location.origin);
              if (target.origin !== window.location.origin) {
                return reply("Refused: this tool only navigates within " + window.location.origin + ".");
              }
              window.location.href = target.href;
              return reply("Navigating to " + target.pathname + ".");
            },
          });
        })();
      </script>
    )}
  </body>
</html>
