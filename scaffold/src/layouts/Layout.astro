---
import "../index.css";
import { Button } from "@/components/ui/button";
import Schema from "@/components/Schema.astro";
import type { Thing, WithContext } from "schema-dts";
import { SITE_DESCRIPTION, SITE_NAME } from "@/lib/site";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	socialImageUrl?: string;
	/** RSS/Atom feed URL, e.g. "/blog/rss.xml". Emits an autodiscovery <link>. */
	feedUrl?: string;
	schema?: WithContext<Thing> | WithContext<Thing>[];
}



// Agent readiness — WebMCP tools for in-page AI agents. On by default: the
// search tool runs on the Pagefind index every build already produces.
// Set to false to stop exposing tools to agents.
const ENABLE_WEBMCP = true;

// Speculation Rules: prerender a same-origin page when the visitor hovers or
// starts to tap a link to it, so the click lands on an already-rendered page.
// Chromium only; other browsers ignore the script. Exclude worker routes
// (/~/*) and anything that changes state. Add `class="no-prerender"` to a
// link to opt it out. Set to false to turn speculative loading off.
const ENABLE_PRERENDER = true;
const SPECULATION_RULES = {
	prerender: [
		{
			where: {
				and: [
					{ href_matches: "/*" },
					{ not: { href_matches: "/~/*" } },
					{ not: { selector_matches: ".no-prerender, [rel~=nofollow], [download]" } },
				],
			},
			eagerness: "moderate",
		},
	],
};

const { url } = Astro;
const {
	title: pageTitle,
	description = SITE_DESCRIPTION,
	noindex = false,
	socialImageUrl,
	feedUrl,
	schema,
} = Astro.props;

// Construct uniform title: "Page Title | Site Name" or just "Site Name"
const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : SITE_NAME;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={url.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:type" content="website" />
    {socialImageUrl && (
      <meta property="og:image" content={socialImageUrl} />
      <meta property="og:image:alt" content={title} />
    )}
    {feedUrl && (
      <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={feedUrl} />
    )}
    {ENABLE_PRERENDER && (
      <script is:inline type="speculationrules" set:html={JSON.stringify(SPECULATION_RULES)} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <Schema item={s} />)
      : <Schema item={schema} />
    )}
  </head>

  <body class="min-h-screen bg-background text-foreground flex flex-col">
    {/* Template header with Hakuto branding */}
    <header class="border-b">
      <div class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">
        <a href="/" class="text-lg font-semibold tracking-tight">Hakuto Template</a>
        {/* Example React island (shadcn/ui). Remove if not needed. */}
        <Button variant="secondary" size="sm">Example Button</Button>
      </div>
    </header>

    <main class="flex-1 mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>

    {ENABLE_WEBMCP && (
      <script is:inline>
        // WebMCP (https://webmcp.org): expose site tools to in-page AI agents.
        // `search-site` is backed by the same Pagefind index the site's own search
        // UI uses — `pagefind()` is in astro.config.mjs, so `astro build` always
        // writes /pagefind/, whether or not a search page exists.
        (function () {
          // The registry lives on `document` (the `navigator` one is deprecated since Chromium 150).
          var ctx = document.modelContext;
          if (!ctx || typeof ctx.registerTool !== "function") return;

          // `execute` returns any JSON-serializable value. A thrown error reaches
          // the agent as a generic failure, so recoverable errors are returned as
          // { error } values instead.

          var pagefindPromise = null;
          function loadPagefind() {
            if (!pagefindPromise) {
              pagefindPromise = import("/pagefind/pagefind.js").then(async (pf) => {
                await pf.init();
                return pf;
              });
              // Do not cache a failure — a retry after a slow deploy should work.
              pagefindPromise.catch(() => {
                pagefindPromise = null;
              });
            }
            return pagefindPromise;
          }

          ctx.registerTool({
            name: "search-site",
            description:
              "Full-text search across every page of this site. Returns the best matching pages with their title, URL and an excerpt. Use this before guessing a URL.",
            inputSchema: {
              type: "object",
              properties: {
                query: { type: "string", description: "Search terms, e.g. 'pricing' or 'refund policy'" },
                limit: {
                  type: "integer",
                  minimum: 1,
                  maximum: 20,
                  default: 5,
                  description: "How many pages to return.",
                },
              },
              required: ["query"],
            },
            // The browser neither validates input against inputSchema nor applies
            // defaults, so both happen here.
            async execute({ query, limit }, opts) {
              var signal = opts && opts.signal;
              if (typeof query !== "string" || !query.trim()) {
                return { error: "Pass the words to search for as `query`." };
              }
              var max = Math.min(Math.max(Math.floor(Number(limit)) || 5, 1), 20);
              var pf;
              try {
                pf = await loadPagefind();
              } catch (e) {
                // The index is only emitted by `astro build`, so this is the normal
                // answer on `astro dev`, not a site defect.
                return {
                  error:
                    "Search index unavailable on this origin (it is generated at build time). Fall back to /sitemap-index.xml or /llms.txt.",
                };
              }
              if (signal) signal.throwIfAborted();
              var search = await pf.search(query);
              if (signal) signal.throwIfAborted();
              var results = await Promise.all(search.results.slice(0, max).map((r) => r.data()));
              if (results.length === 0) {
                return { query: query, total: 0, results: [], message: "No pages matched." };
              }
              return {
                query: query,
                total: search.results.length,
                results: results.map((r) => ({
                  title: (r.meta && r.meta.title) || r.url,
                  url: new URL(r.url, window.location.origin).href,
                  // Pagefind wraps matches in <mark>; agents want plain text.
                  excerpt: String(r.excerpt || "").replace(/<[^>]+>/g, ""),
                })),
              };
            },
            annotations: { readOnlyHint: true },
          });

          ctx.registerTool({
            name: "get-page-content",
            description: "Get the main text content of the page currently open, as plain text.",
            inputSchema: { type: "object", properties: {}, required: [] },
            execute() {
              var main = document.querySelector("main");
              return {
                title: document.title,
                url: window.location.href,
                content: (main || document.body).innerText.slice(0, 4000),
              };
            },
            annotations: { readOnlyHint: true },
          });

          ctx.registerTool({
            name: "navigate",
            description: "Navigate to a page on this site by path, e.g. '/pricing/'.",
            inputSchema: {
              type: "object",
              properties: { path: { type: "string", description: "Site path to navigate to" } },
              required: ["path"],
            },
            execute({ path }) {
              // Same-origin only — this tool must not be a redirect gadget.
              var target = new URL(String(path), window.location.origin);
              if (target.origin !== window.location.origin) {
                return { error: "Refused: this tool only navigates within " + window.location.origin + "." };
              }
              window.location.href = target.href;
              return "Navigating to " + target.pathname + ".";
            },
          });
        })();
      </script>
    )}
  </body>
</html>
