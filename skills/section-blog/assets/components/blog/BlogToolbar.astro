---
// src/components/blog/BlogToolbar.astro — post count, RSS link and (optionally)
// a Pagefind search dialog. Set `search={false}` for a blog without search.
//
// The search dialog only works on a built site: the Pagefind index is written by
// `astro build`, so on `bun run dev` the dialog opens but finds nothing.
import Search from "astro-pagefind/components/Search";

interface Props {
  postCount: number;
  search?: boolean;
}

const { postCount, search = true } = Astro.props;
---

<div class="flex items-center justify-center gap-4 text-sm">
  {search && (
    <>
      <button
        type="button"
        id="blog-search-open"
        class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-primary transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.3-4.3M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z" />
        </svg>
        Search articles
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono bg-foreground/5 border border-foreground/10 rounded" aria-hidden="true">⌘K</kbd>
      </button>
      <span class="text-foreground/20" aria-hidden="true">|</span>
    </>
  )}
  <span class="text-muted-foreground">
    {postCount} {postCount === 1 ? "article" : "articles"}
  </span>
  <span class="text-foreground/20" aria-hidden="true">|</span>
  <a
    href="/blog/rss.xml"
    class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-primary transition-colors"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.002 15.999a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0ZM6 4.5v1.5a9 9 0 0 1 9 9h1.5A10.5 10.5 0 0 0 6 4.5ZM6 9v1.5a4.5 4.5 0 0 1 4.5 4.5H12A6 6 0 0 0 6 9Z" />
    </svg>
    RSS
  </a>
</div>

{search && (
  <dialog id="blog-search-dialog" class="blog-search-dialog" aria-label="Search articles">
    <div class="blog-search-panel">
      <div class="blog-search-header">
        <span class="blog-search-title">Search articles</span>
        <button type="button" class="blog-search-close" aria-label="Close search" data-close>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <Search
        id="blog-search"
        className="blog-search"
        uiOptions={{
          showImages: false,
          showSubResults: false,
          resetStyles: false,
          placeholder: "Search articles…",
          autofocus: true,
        }}
      />
    </div>
  </dialog>
)}

<script>
  const dialog = document.getElementById("blog-search-dialog") as HTMLDialogElement | null;
  const openBtn = document.getElementById("blog-search-open");

  if (dialog && openBtn) {
    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      requestAnimationFrame(() => {
        dialog.querySelector<HTMLInputElement>('input[type="text"]')?.focus();
      });
    };

    openBtn.addEventListener("click", open);

    // Click on the backdrop or the close button closes; Escape is native to <dialog>.
    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.closest("[data-close]")) dialog.close();
    });

    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });
  }
</script>

<!-- is:inline keeps this out of the render-blocking stylesheet bundle. -->
<style is:global is:inline>
  .blog-search-dialog {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100%;
    max-height: 100%;
    width: 100%;
    height: 100%;
    margin: 0;
    color: hsl(var(--foreground));
  }

  /* No backdrop-filter: blur repaints the whole viewport on every frame. */
  .blog-search-dialog::backdrop {
    background: hsl(var(--foreground) / 0.5);
  }

  .blog-search-panel {
    position: relative;
    width: min(960px, calc(100vw - 2rem));
    max-height: calc(100vh - 6rem);
    margin: 3rem auto;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
    box-shadow: var(--shadow-strong);
    padding: 1rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .blog-search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .blog-search-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .blog-search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-right: -0.5rem;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
  }

  .blog-search-close:hover {
    background: hsl(var(--secondary));
    color: hsl(var(--foreground));
  }

  .blog-search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: hsl(var(--primary));
    --pagefind-ui-text: hsl(var(--foreground));
    --pagefind-ui-background: hsl(var(--card));
    --pagefind-ui-border: hsl(var(--border));
    --pagefind-ui-tag: hsl(var(--secondary));
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: inherit;
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }

  .blog-search .pagefind-ui__result-link {
    font-weight: 600;
    color: hsl(var(--heading, var(--foreground)));
  }

  .blog-search .pagefind-ui__result-link:hover {
    color: hsl(var(--primary));
  }

  .blog-search .pagefind-ui__result-excerpt {
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }

  .blog-search .pagefind-ui__search-input:focus {
    border-color: hsl(var(--primary));
    box-shadow: 0 0 0 3px hsl(var(--primary) / 0.15);
    outline: none;
  }

  .blog-search mark {
    background: hsl(var(--primary) / 0.18);
    color: inherit;
    padding: 0 2px;
    border-radius: 2px;
  }
</style>
