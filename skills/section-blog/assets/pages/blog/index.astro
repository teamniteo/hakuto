---
// src/pages/blog/index.astro — page 1: featured (latest) post + first page of cards.
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/blog/PostCard.astro";
import Pagination from "@/components/blog/Pagination.astro";
import BlogToolbar from "@/components/blog/BlogToolbar.astro";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { fallbackFormat } from "@/lib/image-fallback";
import {
  categories,
  categoryHref,
  dateFmt,
  getPosts,
  pagePosts,
  postHref,
  totalPages,
} from "@/lib/blog";

const posts = await getPosts();
const [featured] = posts;
const cards = pagePosts(posts, 1);
const featuredCover = featured?.data.featuredImage as ImageMetadata | undefined;

// The description is a `TODO:` placeholder so prelaunch-checklist flags it —
// replace with the site's own blog intro (not marketing copy).
const BLOG_TITLE = "Blog";
const BLOG_DESCRIPTION = "TODO: One sentence on what this blog covers.";
---

<Layout title={BLOG_TITLE} description={BLOG_DESCRIPTION} feedUrl="/blog/rss.xml" pagefindIgnore>
  <section class="pt-12 pb-10 text-center">
    <h1 class="text-4xl font-bold tracking-tight mb-4">{BLOG_TITLE}</h1>
    <p class="text-lg text-muted-foreground max-w-2xl mx-auto mb-8">{BLOG_DESCRIPTION}</p>

    <div class="flex flex-col items-center gap-4">
      {categories(posts).length > 1 && (
        <ul class="flex flex-wrap items-center justify-center gap-2" aria-label="Categories">
          {categories(posts).map((cat) => (
            <li>
              <a
                href={categoryHref(cat)}
                class="text-sm font-medium px-3 py-1 rounded-full bg-secondary text-secondary-foreground hover:bg-primary hover:text-primary-foreground transition-colors"
              >
                {cat}
              </a>
            </li>
          ))}
        </ul>
      )}
      <BlogToolbar postCount={posts.length} />
    </div>
  </section>

  {featured && (
    <section class="pb-12">
      <a
        href={postHref(featured)}
        class="group block rounded-lg overflow-hidden border border-border hover:shadow-strong transition-shadow"
      >
        <div class="grid md:grid-cols-2">
          {featuredCover ? (
            <div class="aspect-[4/3] md:aspect-auto bg-secondary overflow-hidden">
              <!-- Usually the LCP element on /blog/: eager + high priority, the cards below stay lazy. -->
              <Picture
                src={featuredCover}
                alt=""
                loading="eager"
                fetchpriority="high"
                formats={["webp"]}
                fallbackFormat={fallbackFormat(featuredCover)}
                width={560}
                widths={[560, 1120]}
                sizes="(min-width: 1152px) 560px, (min-width: 768px) 50vw, 100vw"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          ) : (
            <div class="aspect-[4/3] md:aspect-auto bg-gradient-cta" aria-hidden="true"></div>
          )}
          <div class="p-8 md:p-12 flex flex-col justify-center bg-card">
            <p class="text-xs uppercase tracking-widest font-semibold text-primary mb-3">
              Latest · {featured.data.category}
            </p>
            <h2 class="text-2xl md:text-3xl font-bold mb-4 group-hover:text-primary transition-colors">
              {featured.data.title}
            </h2>
            <p class="text-muted-foreground leading-relaxed mb-6">{featured.data.description}</p>
            <p class="text-sm text-muted-foreground">
              <time datetime={featured.data.date.toISOString()}>{dateFmt.format(featured.data.date)}</time>
              {" · "}{featured.data.author}
            </p>
          </div>
        </div>
      </a>
    </section>
  )}

  {cards.length > 0 && (
    <section class="pb-16">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {cards.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination page={1} total={totalPages(posts)} />
    </section>
  )}
</Layout>
